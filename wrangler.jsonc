{
	"name": "tsuzuki",
	"compatibility_date": "2025-03-01",
	"main": "workers/api/index.ts",
	"assets": {
		"directory": "dist/index/browser"
	},

	"d1_databases": [
		{
			"binding": "tsuzuki_db",
			"database_name": "tsuzuki-db",
			"database_id": "dc569ec9-7557-402e-bc32-e167730d17fa",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "tsuzuki-backups",
			"binding": "tsuzuki_backups",
			"remote": true
		}
	]
}