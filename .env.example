# ==============================================================================
# TSUZUKI — Variables de Entorno & Configuración
# ==============================================================================
# NOTA ARQUITECTÓNICA (Cloudflare Workers + Angular):
#
# 1. En Cloudflare Workers / Wrangler:
#    - Los secretos y variables locales se leen de `.dev.vars` (¡NUNCA lo comittees!).
#    - En producción se configuran con: `wrangler secret put <NOMBRE>`
#    - Los bindings estáticos (D1, R2, assets) van en `wrangler.jsonc`.
#
# 2. Si usás este archivo `.env` o `.dev.vars`, renombrá o copialo a `.dev.vars` para Wrangler:
#    cp .env.example .dev.vars
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Access (Fase 2 / S4 - Auth)
# ------------------------------------------------------------------------------
# AUD (Audience tag) de tu aplicación configurada en Cloudflare Zero Trust Access.
# En producción: `wrangler secret put CF_ACCESS_AUDIENCE_ID`
CF_ACCESS_AUDIENCE_ID=tu_audience_tag_aqui

# ------------------------------------------------------------------------------
# 2. Backups Off-site en GitHub (Fase 5 / S9-S10 - Cron & Backups)
# ------------------------------------------------------------------------------
# Personal Access Token (PAT) con permisos de escritura para el repo de backups privado.
# En producción: `wrangler secret put GITHUB_TOKEN`
GITHUB_TOKEN=ghp_tu_token_personal_de_github_aqui

# Repositorio de backups (ej: tu-usuario/tsuzuki-backups)
GITHUB_REPO=valec3/tsuzuki-backups

# Rama de backups
GITHUB_BRANCH=main
